{
  "name": "Python 3.11 Workspace",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "jupyter.defaultKernel": "workspace-venv"
      },
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "echo 'source /opt/venv/bin/activate' >> ~/.bashrc && /opt/venv/bin/python -m ipykernel install --user --name workspace-venv --display-name 'Python 3.11 (Virtual Env)'"
}